<Window x:Class="PCDSQueue.Staff.Views.StaffDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCDS Queue - Staff"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Window.Resources>
        <Geometry x:Key="DashboardIcon">M3,3 H9 V9 H3 Z M11,3 H17 V9 H11 Z M3,11 H9 V17 H3 Z M11,11 H17 V17 H11 Z</Geometry>
        <Geometry x:Key="HistoryIcon">M10,2 A8,8 0 1 0 10.01,2 M10,5 V10 L13,12</Geometry>
        <Geometry x:Key="LogoutIcon">M10,3 H4 V17 H10 M8,10 H17 M14,7 L17,10 L14,13</Geometry>
        <Geometry x:Key="NextIcon">M3,10 H15 M11,6 L15,10 L11,14 M17,4 V16</Geometry>
        <Geometry x:Key="RecallIcon">M3,8 A7,7 0 1 1 4,14 M3,4 V8 H7 M10,6 V10 L13,12</Geometry>
        <Geometry x:Key="CompleteIcon">M3,10 L8,15 L17,5</Geometry>
        <Geometry x:Key="NoShowIcon">M4,4 L16,16 M16,4 L4,16</Geometry>
        <Geometry x:Key="EndShiftIcon">M4,3 H16 V17 H4 Z M7,7 H13 M7,10 H13 M7,13 H11</Geometry>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#066A76">
            <Grid Margin="28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Left" Background="White" CornerRadius="29" Padding="4">
                        <Image Source="/Assets/pcds-crest.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Polytechnic College of Davao del Sur crest" />
                    </Border>
                    <TextBlock Text="PCDS QUEUE" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,17,0,0" />
                    <TextBlock Text="Staff Console" Foreground="#B4E1E3" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,65,0,0">
                    <Button x:Name="DashboardNavButton" Height="45" HorizontalContentAlignment="Left" Padding="14,0" Foreground="White" Background="#066A76" BorderThickness="0" Cursor="Hand" Click="DashboardNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DashboardIcon}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QueueHistoryNavButton" Height="45" Margin="0,18,0,0" HorizontalContentAlignment="Left" Padding="14,0" Foreground="#C8EAEC" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="QueueHistoryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HistoryIcon}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,12,0" />
                            <TextBlock Text="Queue History" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#318F99" Margin="0,0,0,20" />
                    <TextBlock x:Name="SidebarNameText" Text="Staff User" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="SidebarUsernameText" Text="@staff" Foreground="#B4E1E3" FontSize="11" Margin="0,3,0,16" />
                    <Button Height="42" Foreground="White" Background="#065F6B" BorderThickness="0" Cursor="Hand" Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource LogoutIcon}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="White" StrokeThickness="1.5" Margin="0,0,9,0" />
                            <TextBlock Text="LOGOUT" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="40,32">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="DepartmentText" Text="STAFF DASHBOARD" Foreground="#172033" FontSize="27" FontWeight="Bold" />
                    <TextBlock x:Name="WindowText" Text="Select a service window to begin." Foreground="#718096" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Ellipse x:Name="ServerStatusDot"
                             Width="8"
                             Height="8"
                             Fill="#9CA3AF"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusText"
                               Text="Checking server..."
                               Foreground="#718096"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DashboardContent" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="42">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="NOW SERVING" Foreground="#7A8699" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentQueueText" Text="---" Foreground="#066A76" FontSize="105" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CurrentWindowText" Text="NO ACTIVE CUSTOMER" Foreground="#8B96A8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock x:Name="GraceStatusText" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="NextButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource NextIcon}" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Stroke="White" StrokeThickness="1.6" Margin="0,0,9,0" />
                                    <TextBlock Text="NEXT CUSTOMER" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button x:Name="RecallButton" Grid.Column="0" Height="45" IsEnabled="False" Click="RecallButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource RecallIcon}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,7,0" />
                                        <TextBlock Text="RECALL" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CompleteButton" Grid.Column="2" Height="45" IsEnabled="False" Click="CompleteButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource CompleteIcon}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Margin="0,0,7,0" />
                                        <TextBlock Text="COMPLETE" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NoShowButton" Grid.Column="4" Height="45" IsEnabled="False" Click="NoShowButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource NoShowIcon}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,7,0" />
                                        <TextBlock x:Name="NoShowButtonText" Text="NO SHOW" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Padding="25">
                        <StackPanel><TextBlock Text="WAITING" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="WaitingText" Text="0" Foreground="#172033" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="Customers in queue" Foreground="#9AA4B2" FontSize="11" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,18,0,0">
                        <StackPanel><TextBlock Text="NEXT NUMBER" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="NextQueueText" Text="---" Foreground="#077F8D" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="Next waiting customer" Foreground="#9AA4B2" FontSize="11" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="CURRENT SHIFT" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Ellipse Width="9" Height="9" Fill="#16A36A" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShiftStatusText" Text="ACTIVE" Foreground="#16784C" FontWeight="SemiBold" Margin="9,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ShiftDepartmentText" Foreground="#172033" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0" />
                            <TextBlock x:Name="ShiftWindowText" Foreground="#718096" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock x:Name="ShiftStartedText" Foreground="#9AA4B2" FontSize="11" Margin="0,4,0,0" />
                            <Button x:Name="EndShiftButton" Height="42" Margin="0,20,0,0" IsEnabled="False" Click="EndShiftButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource EndShiftIcon}" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,8,0" />
                                    <TextBlock Text="END SHIFT" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid x:Name="HistoryContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="QUEUE HISTORY" Foreground="#172033" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Latest 100 queue transactions in your department" Foreground="#718096" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22">
                    <DataGrid x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="50"
                              ColumnHeaderHeight="45"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NUMBER" Binding="{Binding QueueNumber}" Width="*" />
                            <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowDisplay}" Width="*" />
                            <DataGridTextColumn Header="STAFF" Binding="{Binding StaffName}" Width="1.5*" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="CALLED" Binding="{Binding CalledDisplay}" Width="*" />
                            <DataGridTextColumn Header="COMPLETED" Binding="{Binding CompletedDisplay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
