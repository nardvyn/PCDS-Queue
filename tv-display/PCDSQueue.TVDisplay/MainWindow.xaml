<Window x:Class="PCDSQueue.TVDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCDS Queue Display"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F3F7FB"
        UseLayoutRounding="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#D9E4EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#123E73">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PCDS QUEUE" Foreground="White"
                               FontSize="34" FontWeight="Bold" />
                    <TextBlock Text="CAMPUS QUEUE DISPLAY" Foreground="#C6D7EA"
                               FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="28"
                               FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" Foreground="#D8E5F2" FontSize="14"
                               Margin="0,2,0,5" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="ServerDot" Width="10" Height="10"
                                 Fill="#28C76F" Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerText" Text="CONNECTING TO SERVER"
                                   Foreground="White" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MainCallCard" Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelCard}">
                        <Setter Property="Padding" Value="30" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, ElementName=MainCallCard}"
                                         Value="True">
                                <Setter Property="Background" Value="#FFF2D9" />
                                <Setter Property="BorderBrush" Value="#D18A00" />
                                <Setter Property="BorderThickness" Value="5" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="MainRecallFlash">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.5"
                                                             Duration="0:0:0.2"
                                                             AutoReverse="True"
                                                             RepeatBehavior="3x" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="MainRecallFlash" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="#0F559D" CornerRadius="30"
                            HorizontalAlignment="Center" Padding="44,10"
                            Margin="0,0,0,10">
                        <TextBlock Text="NOW SERVING" Foreground="White"
                                   FontSize="30" FontWeight="Bold" />
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="MainCallEmptyPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyStateHeading" Text="NO ACTIVE CALLS"
                                       Foreground="#073B72" FontSize="36"
                                       FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateMessage"
                                       Text="Please wait for your number to be called."
                                       Foreground="#57718C" FontSize="20"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MainQueueNumber" Text=""
                                   Foreground="#073B72" FontSize="190"
                                   FontWeight="Black" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="40,0,40,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#DCEEFF"
                                CornerRadius="14" Padding="18">
                            <StackPanel>
                                <TextBlock Text="DEPARTMENT" Foreground="#57718C"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainDepartment" Foreground="#073B72"
                                           FontSize="34" FontWeight="Bold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0F559D"
                                CornerRadius="14" Padding="18">
                            <StackPanel>
                                <TextBlock Text="SERVICE WINDOW" Foreground="#DCEEFF"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainWindowNumber" Foreground="White"
                                           FontSize="34" FontWeight="Bold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="ProceedText"
                               Text="Please proceed to the assigned service window."
                               Foreground="#073B72" FontSize="24"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,4,0,4" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#073B72"
                                CornerRadius="16,16,0,0">
                            <Grid Margin="20,0">
                                <TextBlock Text="ACTIVE CALLS" Foreground="White"
                                           FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="CallCountText" Text="00 ACTIVE"
                                           Foreground="#D5E6F6" FontSize="14"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ServingItems" Margin="14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="0,0,0,10"
                                                Padding="14,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F3F7FB" />
                                                    <Setter Property="BorderBrush" Value="#F3F7FB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAnnouncementHighlighted}"
                                                                     Value="True">
                                                            <Setter Property="Background" Value="#FFF2D9" />
                                                            <Setter Property="BorderBrush" Value="#D18A00" />
                                                            <Setter Property="BorderThickness" Value="3" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="ActiveRecallFlash">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.5"
                                                                                         Duration="0:0:0.2"
                                                                                         AutoReverse="True"
                                                                                         RepeatBehavior="3x" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="ActiveRecallFlash" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding QueueNumber}"
                                                           Foreground="#073B72" FontSize="27"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="14,0,8,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DepartmentName}"
                                                               Foreground="#162D46" FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding WindowDisplay}"
                                                               Foreground="#445E77" FontSize="13"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="NOW SERVING"
                                                           Foreground="#16834A" FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#073B72" CornerRadius="16,16,0,0">
                            <TextBlock Text="WAITING NOW" Foreground="White"
                                       FontSize="21" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="20,0" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WaitingItems" Margin="14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF2D9" CornerRadius="10"
                                                Margin="4" Padding="8,7">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DepartmentName}"
                                                           Foreground="#162D46" FontSize="12"
                                                           FontWeight="Bold"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WaitingCount}"
                                                           Foreground="#073B72" FontSize="30"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="WAITING"
                                                           Foreground="#445E77" FontSize="10"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#073B72">
            <Grid Margin="35,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PCDS QUEUE" Foreground="White"
                               FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="FASTER SERVICE. BETTER CAMPUS EXPERIENCE."
                               Foreground="#BCD3E9" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL WAITING" Foreground="#BFD4E9"
                               FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingCountText" Text="0" Foreground="White"
                               FontSize="25" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="11" Height="11"
                             Fill="#40D693" Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="LiveText" Text="LIVE" Foreground="White"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
