<Window x:Class="PCDSQueue.Admin.Views.ServiceWindowFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Window" Width="470" Height="340" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="ADD SERVICE WINDOW"
                       Foreground="{StaticResource TextBrush}" FontSize="21" FontWeight="Bold" />
            <TextBlock x:Name="DepartmentText" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="WINDOW NAME" FontSize="11" FontWeight="SemiBold"
                       Foreground="#4A5568" Margin="0,0,0,7" />
            <TextBox x:Name="WindowNameTextBox" Style="{StaticResource ModernTextBox}" MaxLength="100" />
            <TextBlock x:Name="ErrorText" Foreground="#DC3545" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Width="100" Height="42" IsCancel="True" />
            <Button x:Name="SaveButton" Content="CREATE" Width="120" Height="42"
                    Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>