<Window x:Class="PCDSQueue.Admin.Views.StaffAccountFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Account" Width="500" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="ADD STAFF ACCOUNT"
                       Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="Create a Staff login and assign a department"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <StackPanel x:Name="FullNameField">
                <TextBlock Text="FULL NAME" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A5568" Margin="0,0,0,7" />
                <TextBox x:Name="FullNameTextBox" Style="{StaticResource ModernTextBox}" MaxLength="150" />
            </StackPanel>
            <StackPanel x:Name="UsernameField" Margin="0,14,0,0">
                <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A5568" Margin="0,0,0,7" />
                <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernTextBox}" MaxLength="100" />
            </StackPanel>
            <StackPanel x:Name="PasswordField" Margin="0,14,0,0">
                <TextBlock x:Name="PasswordLabel" Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A5568" Margin="0,0,0,7" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}" />
            </StackPanel>
            <StackPanel x:Name="DepartmentField" Margin="0,14,0,0">
                <TextBlock Text="DEPARTMENT" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A5568" Margin="0,0,0,7" />
                <ComboBox x:Name="DepartmentComboBox" Height="42" DisplayMemberPath="DepartmentName"
                          VerticalContentAlignment="Center" Padding="10,0" />
            </StackPanel>
            <StackPanel x:Name="AccountStatusField" Margin="0,14,0,0">
                <TextBlock Text="ACCOUNT STATUS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A5568" Margin="0,0,0,7" />
                <ComboBox x:Name="AccountStatusComboBox" Height="42" SelectedIndex="0"
                          VerticalContentAlignment="Center" Padding="10,0">
                    <ComboBoxItem Content="ACTIVE" />
                    <ComboBoxItem Content="INACTIVE" />
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#DC3545" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Width="100" Height="42" IsCancel="True" />
            <Button x:Name="SaveButton" Content="CREATE ACCOUNT" Width="150" Height="42"
                    Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>