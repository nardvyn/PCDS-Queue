<Window x:Class="PCDSQueue.Admin.Views.QueueHistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue Transaction Details" Width="760" Height="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock x:Name="QueueNumberText" Text="QUEUE" Foreground="{StaticResource TextBrush}"
                           FontSize="25" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Text="STATUS" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock x:Name="SourceText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DEPARTMENT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="DepartmentText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="WINDOW" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="WindowText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="STAFF" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="StaffText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="GENERATED" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="GeneratedText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="CALLED" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="CalledText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="COMPLETED" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock x:Name="CompletedText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="WAITING TIME" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="WaitingDurationText" Foreground="{StaticResource TextBrush}"
                               FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="SERVICE TIME" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServiceDurationText" Foreground="{StaticResource TextBrush}"
                               FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="LIFECYCLE EVENTS" Foreground="{StaticResource TextBrush}"
               FontSize="13" FontWeight="Bold" />
        <Border Grid.Row="6" Style="{StaticResource DashboardCard}" Padding="12">
            <DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38"
                      ColumnHeaderHeight="38" AlternatingRowBackground="#F8FAFC"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeDisplay}" Width="130" />
                    <DataGridTextColumn Header="EVENT" Binding="{Binding EventType}" Width="130" />
                    <DataGridTextColumn Header="STAFF" Binding="{Binding StaffDisplay}" Width="*" />
                    <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowDisplay}" Width="*" />
                    <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="8" Content="CLOSE" Width="100" Height="40"
                HorizontalAlignment="Right" IsCancel="True" />
    </Grid>
</Window>