<Window x:Class="PCDSQueue.Admin.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PCDSQueue.Admin.Views"
        Title="PCDS Queue Admin"
        Width="1280" Height="800" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Geometry x:Key="DashboardIcon">M3,3 H9 V9 H3 Z M11,3 H17 V9 H11 Z M3,11 H9 V17 H3 Z M11,11 H17 V17 H11 Z</Geometry>
        <Geometry x:Key="DepartmentsIcon">M3,17 H17 M5,17 V5 H15 V17 M7,8 H9 M11,8 H13 M7,11 H9 M11,11 H13 M8,17 V14 H12 V17</Geometry>
        <Geometry x:Key="ServiceWindowsIcon">M3,8 L4.5,3 H15.5 L17,8 M4,8 V17 H16 V8 M4,8 H16 M8,8 V11 H12 V8 M7,13 H13 V17</Geometry>
        <Geometry x:Key="StaffAccountsIcon">M7,8 A2.5,2.5 0 1 0 7,3 A2.5,2.5 0 1 0 7,8 M2,17 V15 A5,5 0 0 1 12,15 V17 M13,4 A2.5,2.5 0 0 1 13,9 M14,12 A4,4 0 0 1 18,16 V17</Geometry>
        <Geometry x:Key="LiveQueueIcon">M2,10 H5 L7,5 L10,15 L12,8 L14,11 H18</Geometry>
        <Geometry x:Key="QueueHistoryIcon">M10,2 A8,8 0 1 0 10.01,2 M10,5 V10 L13,12</Geometry>
        <Geometry x:Key="ReportsIcon">M3,17 V3 M3,17 H18 M6,14 V10 H9 V14 M11,14 V6 H14 V14 M16,14 V3 H18 V14</Geometry>
        <Geometry x:Key="QrManagementIcon">M3,3 H8 V8 H3 Z M12,3 H17 V8 H12 Z M3,12 H8 V17 H3 Z M12,12 H14 V14 H12 Z M16,12 H17 V14 H16 Z M12,16 H14 V17 H12 Z M16,16 H17 V17 H16 Z</Geometry>
        <Geometry x:Key="SettingsIcon">M3,5 H7 M11,5 H17 M3,10 H12 M16,10 H17 M3,15 H5 M9,15 H17 M7,3 A2,2 0 1 0 7,7 A2,2 0 1 0 7,3 M14,8 A2,2 0 1 0 14,12 A2,2 0 1 0 14,8 M7,13 A2,2 0 1 0 7,17 A2,2 0 1 0 7,13</Geometry>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Left"
                            CornerRadius="29" Background="White" Padding="4">
                        <Image Source="/Assets/pcds-crest.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Polytechnic College of Davao del Sur crest" />
                    </Border>
                    <TextBlock Text="PCDS QUEUE ADMIN" Foreground="White"
                               FontWeight="Bold" FontSize="15" Margin="0,15,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <Button x:Name="DashboardNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Foreground="White" Background="#066A76" Click="DashboardNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DashboardIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DepartmentsNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,8,0,0" Click="DepartmentsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DepartmentsIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Departments" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServiceWindowsNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="ServiceWindowsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ServiceWindowsIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Service Windows" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StaffAccountsNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="StaffAccountsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource StaffAccountsIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Staff Accounts" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LiveQueueNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="LiveQueueButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LiveQueueIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Live Queue" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QueueHistoryNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="QueueHistoryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource QueueHistoryIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Queue History" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReportsNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="ReportsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ReportsIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Reports" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QrManagementNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="QrManagementButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource QrManagementIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="QR Management" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavigationButton" Style="{StaticResource AdminNavigationButton}"
                            Margin="0,4,0,0" Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsIcon}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#318F99" Margin="0,0,0,18" />
                    <TextBlock x:Name="AdminNameText" Text="Administrator" Foreground="White"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="AdminUsernameText" Text="@admin" Foreground="#B4E1E3"
                               FontSize="11" Margin="0,4,0,14" />
                    <Button Content="LOG OUT" Height="40" Foreground="White"
                            Background="#065F6B" BorderThickness="0" Cursor="Hand"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="PageTitleText" Text="ADMIN DASHBOARD"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="26" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitleText" Text="Campus queue overview for today"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,0,0">
                    <Ellipse x:Name="ServerStatusDot" Width="8" Height="8"
                             Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusText" Text="Checking server..."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DashboardPage" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="WAITING TODAY" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="WaitingTodayText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="34" FontWeight="Bold" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="CURRENTLY SERVING" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentlyServingText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="34" FontWeight="Bold" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE WINDOWS" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="ActiveWindowsText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="34" FontWeight="Bold" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="DEPARTMENTS" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="DepartmentsText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="34" FontWeight="Bold" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DEPARTMENT STATUS" Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="DashboardErrorText" Grid.Row="1" Foreground="#DC3545"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Margin="0,10,0,0" />
                    <DataGrid x:Name="DepartmentStatusGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0"
                              RowHeight="48" ColumnHeaderHeight="42"
                              AlternatingRowBackground="#F8FAFC"
                              Background="White" Margin="0,14,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding DepartmentName}" Width="*" />
                            <DataGridTextColumn Header="ACTIVE WINDOWS" Binding="{Binding ActiveWindows}" Width="170" />
                            <DataGridTextColumn Header="WAITING" Binding="{Binding WaitingCount}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </Border>
            </Grid>

            <views:DepartmentsWindow x:Name="DepartmentsPage" Grid.Row="2" Visibility="Collapsed" />
                <views:ServiceWindowsWindow x:Name="ServiceWindowsPage" Grid.Row="2" Visibility="Collapsed" />
                <views:StaffAccountsWindow x:Name="StaffAccountsPage" Grid.Row="2" Visibility="Collapsed" />
                <views:LiveQueueWindow x:Name="LiveQueuePage" Grid.Row="2" Visibility="Collapsed" />
                <views:QueueHistoryWindow x:Name="QueueHistoryPage" Grid.Row="2" Visibility="Collapsed" />
                <views:ReportsWindow x:Name="ReportsPage" Grid.Row="2" Visibility="Collapsed" />
                <views:QrManagementWindow x:Name="QrManagementPage" Grid.Row="2" Visibility="Collapsed" />
                <views:SettingsWindow x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>