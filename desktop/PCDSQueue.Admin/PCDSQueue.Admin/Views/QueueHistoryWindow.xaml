<UserControl x:Class="PCDSQueue.Admin.Views.QueueHistoryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FROM" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker x:Name="DateFromPicker" Grid.Column="1" Height="36"
                        VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="3" Text="TO" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker x:Name="DateToPicker" Grid.Column="4" Height="36"
                        VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="6" Text="DEPARTMENT" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="DepartmentFilterComboBox" Grid.Column="7" Height="36"
                      DisplayMemberPath="DepartmentName" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="STATUS" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="StatusFilterComboBox" Grid.Column="1" Height="36"
                      VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="All statuses" Tag="ALL" />
                <ComboBoxItem Content="WAITING" Tag="WAITING" />
                <ComboBoxItem Content="CALLED" Tag="CALLED" />
                <ComboBoxItem Content="SERVING" Tag="SERVING" />
                <ComboBoxItem Content="COMPLETED" Tag="COMPLETED" />
                <ComboBoxItem Content="NO_SHOW" Tag="NO_SHOW" />
                <ComboBoxItem Content="CANCELLED" Tag="CANCELLED" />
            </ComboBox>
            <TextBlock Grid.Column="3" Text="SOURCE" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="SourceFilterComboBox" Grid.Column="4" Height="36"
                      VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="All sources" Tag="ALL" />
                <ComboBoxItem Content="KIOSK" Tag="KIOSK" />
                <ComboBoxItem Content="MOBILE" Tag="MOBILE" />
            </ComboBox>
            <Button x:Name="SearchButton" Grid.Column="6" Content="SEARCH" Height="36"
                    Style="{StaticResource PrimaryButton}" Click="SearchButton_Click" />
            <Button Grid.Column="8" Content="RESET" Height="36"
                    Click="ResetButton_Click" />
            <Button x:Name="ViewDetailsButton" Grid.Column="10" Content="VIEW DETAILS"
                    Height="36" IsEnabled="False" Click="ViewDetailsButton_Click" />
        </Grid>

        <TextBlock x:Name="HistoryErrorText" Grid.Row="4" Foreground="#DC3545"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <Border Grid.Row="6" Style="{StaticResource DashboardCard}" Padding="12">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="40" ColumnHeaderHeight="40"
                      AlternatingRowBackground="#F8FAFC" Background="White"
                      SelectionChanged="HistoryGrid_SelectionChanged"
                      MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NUMBER" Binding="{Binding QueueNumber}" Width="100" />
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding DepartmentName}" Width="1.2*" />
                    <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowDisplay}" Width="90" />
                    <DataGridTextColumn Header="STAFF" Binding="{Binding StaffDisplay}" Width="1.2*" />
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="115" />
                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedDisplay}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>