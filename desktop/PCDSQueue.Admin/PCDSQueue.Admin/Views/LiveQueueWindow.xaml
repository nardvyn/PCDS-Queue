<UserControl x:Class="PCDSQueue.Admin.Views.LiveQueueWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DEPARTMENT" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <ComboBox x:Name="DepartmentFilterComboBox" Grid.Column="1" Height="40"
                      DisplayMemberPath="DepartmentName" VerticalContentAlignment="Center"
                      SelectionChanged="DepartmentFilterComboBox_SelectionChanged" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#9CA3AF"
                         Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LiveStateText" Text="Connecting..."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="LastUpdatedText" Text=""
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="LiveErrorText" Grid.Row="1" Foreground="#DC3545"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="WAITING" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="WaitingCountText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="32" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="SERVING" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServingCountText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="32" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="WINDOWS IN USE" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="WindowsInUseText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="32" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="CURRENTLY SERVING" Foreground="{StaticResource TextBrush}"
                   FontSize="14" FontWeight="Bold" />
        <Border Grid.Row="7" Style="{StaticResource DashboardCard}" Padding="12">
            <DataGrid x:Name="ServingGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                      ColumnHeaderHeight="38" AlternatingRowBackground="#F8FAFC"
                      Background="White" IsTabStop="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NUMBER" Binding="{Binding QueueNumber}" Width="110" />
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding DepartmentName}" Width="*" />
                    <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowDisplay}" Width="100" />
                    <DataGridTextColumn Header="STAFF" Binding="{Binding StaffDisplay}" Width="1.2*" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="9" Text="WAITING QUEUE" Foreground="{StaticResource TextBrush}"
                   FontSize="14" FontWeight="Bold" />
        <Border Grid.Row="11" Style="{StaticResource DashboardCard}" Padding="12">
            <DataGrid x:Name="WaitingGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                      ColumnHeaderHeight="38" AlternatingRowBackground="#F8FAFC"
                      Background="White" IsTabStop="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NUMBER" Binding="{Binding QueueNumber}" Width="120" />
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding DepartmentName}" Width="*" />
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding SourceDisplay}" Width="150" />
                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedDisplay}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>