<Window x:Class="PCDSQueue.Staff.Views.StaffDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCDS Queue - Staff"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#102E68">
            <Grid Margin="28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="52" Height="52" HorizontalAlignment="Left" Background="White" CornerRadius="12">
                        <TextBlock Text="P" Foreground="#173F8A" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PCDS QUEUE" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,17,0,0" />
                    <TextBlock Text="Staff Console" Foreground="#9FB5DA" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,65,0,0">
                    <Button x:Name="DashboardNavButton" Content="Dashboard" Height="45" HorizontalContentAlignment="Left" Padding="14,0" Foreground="White" Background="#1D478B" BorderThickness="0" Cursor="Hand" Click="DashboardNavButton_Click" />
                    <Button x:Name="QueueHistoryNavButton" Content="Queue History" Height="45" Margin="0,18,0,0" HorizontalContentAlignment="Left" Padding="14,0" Foreground="#B5C8E7" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="QueueHistoryButton_Click" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#31518A" Margin="0,0,0,20" />
                    <TextBlock x:Name="SidebarNameText" Text="Staff User" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="SidebarUsernameText" Text="@staff" Foreground="#9FB5DA" FontSize="11" Margin="0,3,0,16" />
                    <Button Content="LOGOUT" Height="42" Foreground="White" Background="#1A427E" BorderThickness="0" Cursor="Hand" Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="40,32">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="DepartmentText" Text="STAFF DASHBOARD" Foreground="#172033" FontSize="27" FontWeight="Bold" />
                    <TextBlock x:Name="WindowText" Text="Select a service window to begin." Foreground="#718096" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Ellipse x:Name="ServerStatusDot"
                             Width="8"
                             Height="8"
                             Fill="#9CA3AF"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusText"
                               Text="Checking server..."
                               Foreground="#718096"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DashboardContent" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="42">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="NOW SERVING" Foreground="#7A8699" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentQueueText" Text="---" Foreground="#102E68" FontSize="105" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CurrentWindowText" Text="NO ACTIVE CUSTOMER" Foreground="#8B96A8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="NextButton" Content="NEXT CUSTOMER" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="NextButton_Click" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button x:Name="RecallButton" Grid.Column="0" Content="RECALL" Height="45" IsEnabled="False" Click="RecallButton_Click" />
                                <Button x:Name="CompleteButton" Grid.Column="2" Content="COMPLETE" Height="45" IsEnabled="False" Click="CompleteButton_Click" />
                                <Button x:Name="NoShowButton" Grid.Column="4" Content="NO SHOW" Height="45" IsEnabled="False" Click="NoShowButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Padding="25">
                        <StackPanel><TextBlock Text="WAITING" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="WaitingText" Text="0" Foreground="#172033" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="Customers in queue" Foreground="#9AA4B2" FontSize="11" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,18,0,0">
                        <StackPanel><TextBlock Text="NEXT NUMBER" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="NextQueueText" Text="---" Foreground="#173F8A" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="Next waiting customer" Foreground="#9AA4B2" FontSize="11" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="CURRENT SHIFT" Foreground="#7A8699" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Ellipse Width="9" Height="9" Fill="#16A36A" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShiftStatusText" Text="ACTIVE" Foreground="#16784C" FontWeight="SemiBold" Margin="9,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ShiftDepartmentText" Foreground="#172033" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0" />
                            <TextBlock x:Name="ShiftWindowText" Foreground="#718096" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock x:Name="ShiftStartedText" Foreground="#9AA4B2" FontSize="11" Margin="0,4,0,0" />
                            <Button x:Name="EndShiftButton" Content="END SHIFT" Height="42" Margin="0,20,0,0" IsEnabled="False" Click="EndShiftButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid x:Name="HistoryContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="QUEUE HISTORY" Foreground="#172033" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Latest 100 queue transactions in your department" Foreground="#718096" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22">
                    <DataGrid x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="50"
                              ColumnHeaderHeight="45"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NUMBER" Binding="{Binding QueueNumber}" Width="*" />
                            <DataGridTextColumn Header="WINDOW" Binding="{Binding WindowDisplay}" Width="*" />
                            <DataGridTextColumn Header="STAFF" Binding="{Binding StaffName}" Width="1.5*" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="CALLED" Binding="{Binding CalledDisplay}" Width="*" />
                            <DataGridTextColumn Header="COMPLETED" Binding="{Binding CompletedDisplay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
