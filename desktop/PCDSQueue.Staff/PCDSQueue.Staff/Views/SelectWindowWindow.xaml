<Window x:Class="PCDSQueue.Staff.Views.SelectWindowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCDS Queue - Select Window"
        Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="42,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="P" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,1,0,0">
                    <TextBlock Text="PCDS QUEUE" Foreground="#172033" FontWeight="Bold" FontSize="17" />
                    <TextBlock Text="Staff Console" Foreground="#718096" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#ECFDF3" CornerRadius="20" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#16A36A" VerticalAlignment="Center" />
                    <TextBlock Text="Server Online" Foreground="#16784C" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,42,0,28">
            <TextBlock Text="Select Service Window" Foreground="#172033" FontSize="30" FontWeight="Bold" />
            <TextBlock x:Name="DepartmentText" Text="Loading department..." Foreground="{StaticResource PrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" />
            <TextBlock Text="Choose an available window to start your shift." Foreground="#718096" FontSize="14" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="WindowsPanel" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,28,0,0">
            <StackPanel>
                <TextBlock x:Name="SelectionText" Text="Select an available window." Foreground="#718096" FontSize="13" />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#BE123C" FontSize="12" Margin="0,7,0,0" />
            </StackPanel>
            <Button x:Name="StartShiftButton" Content="START SHIFT" Style="{StaticResource PrimaryButton}" Width="180" HorizontalAlignment="Right" IsEnabled="False" Click="StartShiftButton_Click" />
        </Grid>
    </Grid>
</Window>
