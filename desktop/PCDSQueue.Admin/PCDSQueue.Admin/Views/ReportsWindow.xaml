<UserControl x:Class="PCDSQueue.Admin.Views.ReportsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FROM" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker x:Name="DateFromPicker" Grid.Column="1" Height="36" />
            <TextBlock Grid.Column="3" Text="TO" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker x:Name="DateToPicker" Grid.Column="4" Height="36" />
            <TextBlock Grid.Column="6" Text="DEPARTMENT" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="DepartmentFilterComboBox" Grid.Column="7" Height="36"
                      DisplayMemberPath="DepartmentName" VerticalContentAlignment="Center" />
            <Button x:Name="GenerateButton" Grid.Column="9" Content="GENERATE"
                    Height="38" Style="{StaticResource PrimaryButton}"
                    Click="GenerateButton_Click" />
        </Grid>

        <TextBlock x:Name="ReportErrorText" Grid.Row="2" Foreground="#DC3545"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL QUEUES" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalQueuesText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="30" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="COMPLETED" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="CompletedText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="30" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="NO SHOW" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="NoShowText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="30" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="AVG WAITING TIME" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="AverageWaitingText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="26" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="AVG SERVICE TIME" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="AverageServiceText" Text="--" Foreground="{StaticResource TextBrush}"
                               FontSize="26" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="8" Text="DEPARTMENT PERFORMANCE"
                   Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" />
        <Border Grid.Row="10" Style="{StaticResource DashboardCard}" Padding="12">
            <DataGrid x:Name="DepartmentPerformanceGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="42" ColumnHeaderHeight="40"
                      AlternatingRowBackground="#F8FAFC" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding DepartmentName}" Width="*" />
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalQueues}" Width="100" />
                    <DataGridTextColumn Header="COMPLETED" Binding="{Binding Completed}" Width="120" />
                    <DataGridTextColumn Header="NO SHOW" Binding="{Binding NoShow}" Width="110" />
                    <DataGridTextColumn Header="AVG WAIT" Binding="{Binding AverageWaitingDisplay}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>